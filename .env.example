# =====================================================================
# Configuración — Asistente de Seguros (Seguros Express)
# Chat (LLM) y embeddings usan Mistral: una sola API key.
# Obtén tu key gratuita en: https://console.mistral.ai/api-keys
# =====================================================================

# --- Chat / LLM: Mistral (API compatible con OpenAI) ------------------
LLM_BASE_URL="https://api.mistral.ai/v1"
LLM_API_KEY=""
LLM_MODEL="mistral-small-latest"
LLM_MODEL_SMALL="ministral-8b-latest"

# --- Embeddings: Mistral ----------------------------------------------
EMBEDDING_MODEL="mistral-embed"

# --- RAG vectorial (Chroma) -------------------------------------------
VECTOR_DB_PATH="data/chroma"
CHUNK_SIZE="700"
CHUNK_OVERLAP="120"
RETRIEVAL_TOP_K="4"
# Relevancia mínima (coseno) para aceptar un fragmento vectorial como válido
VECTOR_SCORE_THRESHOLD="0.68"

# --- Memoria conversacional -------------------------------------------
# Corto plazo: ventana deslizante persistida en disco
MEMORY_MAX_TURNS="5"
MEMORY_PERSIST_PATH=".memory/session.json"
# Largo plazo: memoria semántica (Chroma)
LONGTERM_DB_PATH="data/chroma_memory"
