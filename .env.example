# =====================================================================
# Configuración — Asistente de Seguros (Seguros Express)
# Chat (LLM) y embeddings usan un endpoint OpenAI-compatible.
# Por defecto: NVIDIA NIM (https://integrate.api.nvidia.com/v1).
# Obtén tu key gratuita en: https://build.nvidia.com (formato nvapi-...)
# =====================================================================

# --- Proveedor del chat -----------------------------------------------
# "ollama" = modelo local (rápido, offline, gratis)  [por defecto]
# "nvidia" = API remota OpenAI-compatible (NVIDIA NIM)
# Los EMBEDDINGS siempre usan NVIDIA (ver sección de embeddings).
PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:14b-instruct"
OLLAMA_NUM_CTX="8192"

# --- Chat / LLM remoto (NVIDIA NIM, se usa si PROVIDER=nvidia) --------
LLM_BASE_URL="https://integrate.api.nvidia.com/v1"
LLM_API_KEY="nvapi-..."
LLM_MODEL="openai/gpt-oss-20b"
LLM_MODEL_SMALL="openai/gpt-oss-20b"

# --- Embeddings (OpenAI-compatible, multilingüe) ----------------------
EMBEDDING_MODEL="nvidia/llama-nemotron-embed-vl-1b-v2"

# --- RAG vectorial (Chroma) -------------------------------------------
VECTOR_DB_PATH="data/chroma"
CHUNK_SIZE="700"
CHUNK_OVERLAP="120"
RETRIEVAL_TOP_K="4"
# Relevancia mínima (coseno) para aceptar un fragmento vectorial como válido
VECTOR_SCORE_THRESHOLD="0.30"

# --- Topes de costo / seguridad ---------------------------------------
# Máximo de tokens por respuesta del modelo
MAX_TOKENS="700"
# Máximo de pasos del grafo (evita bucles de herramientas descontrolados)
AGENT_RECURSION_LIMIT="6"
# Usar el supervisor LLM solo para consultas ambiguas (router por keywords primero)
USE_LLM_ROUTER="false"
# Memoria semántica de largo plazo (agrega embeddings e infla el contexto)
USE_LONG_TERM="false"

# --- Memoria conversacional -------------------------------------------
# Corto plazo: ventana deslizante persistida en disco
MEMORY_MAX_TURNS="5"
MEMORY_PERSIST_PATH=".memory/session.json"
# Largo plazo: memoria semántica (Chroma)
LONGTERM_DB_PATH="data/chroma_memory"
